# Next.js only loads env files from this app's own directory — copy to
# apps/web/.env.local (Next's convention, already in .gitignore patterns)
# if you need to override these for local (non-Docker) dev. Not needed for
# plain `pnpm dev`: the fallback (http://localhost:4000) already matches
# apps/api's default port.

# Browser-reachable API origin — inlined into the client bundle at build
# time. See apps/web/lib/api.ts's doc comment.
NEXT_PUBLIC_API_URL=http://localhost:4000
