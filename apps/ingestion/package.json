{
  "name": "@sports/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format cjs --clean",
    "start": "node --env-file=../../.env dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts",
    "history:f1": "tsx --env-file=../../.env src/history/f1/cli.ts",
    "history:f1:rolling": "tsx --env-file=../../.env src/history/f1/cli.ts --years=3 --limit=30",
    "history:f1:details": "tsx --env-file=../../.env src/history/f1/detailCli.ts",
    "history:f1:details:rolling": "tsx --env-file=../../.env src/history/f1/detailCli.ts --years=3 --limit=30 --session-types=ALL",
    "history:f1:standings:rolling": "tsx --env-file=../../.env src/history/f1/standingsCli.ts --years=3"
  },
  "dependencies": {
    "@sports/db": "workspace:*",
    "@sports/domain": "workspace:*",
    "@sports/providers-core": "workspace:*",
    "@sports/providers-f1-jolpica": "workspace:*",
    "@sports/providers-f1-openf1": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
