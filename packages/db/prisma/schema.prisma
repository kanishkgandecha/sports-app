// Formula 1 data model. The generic event/session names remain useful F1
// vocabulary while sport-specific timing data stays in extension tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core (shared across every sport)
// ---------------------------------------------------------------------------

model Sport {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  status String // "live" | "beta" | "education-only"

  competitions Competition[]
  teams        Team[]
  players      Player[]
  fixtures     Fixture[]
  liveEvents   LiveEvent[]

  @@index([slug])
}

model Competition {
  id      String @id @default(cuid())
  sportId String
  slug    String
  name    String
  type    String // "championship" | "league" | "tournament" | "cup"

  sport     Sport      @relation(fields: [sportId], references: [id])
  seasons   Season[]
  fixtures  Fixture[]
  standings Standing[]

  @@unique([sportId, slug])
  @@index([sportId])
}

model Season {
  id            String   @id @default(cuid())
  competitionId String
  label         String
  startDate     DateTime
  endDate       DateTime

  competition Competition @relation(fields: [competitionId], references: [id])
  fixtures    Fixture[]
  standings   Standing[]

  @@unique([competitionId, label])
  @@index([competitionId])
}

model Venue {
  id       String @id @default(cuid())
  name     String
  country  String
  timezone String

  fixtures Fixture[]
}

model Team {
  id       String  @id @default(cuid())
  sportId  String
  name     String
  slug     String
  country  String?
  /// Brand/kit color e.g. "#3671C6". Cross-sport, not F1-specific — see docs/CONTEXT.md §7.4.2.
  colorHex String?

  sport   Sport    @relation(fields: [sportId], references: [id])
  players Player[]

  @@unique([sportId, slug])
  @@index([sportId])
}

model Player {
  id        String  @id @default(cuid())
  sportId   String
  teamId    String?
  name      String
  role      String?
  /// Abbreviated display code, e.g. F1's "VER". Cross-sport — see docs/CONTEXT.md §7.4.3.
  shortName String?
  /// Athlete photo/headshot. Cross-sport — see docs/CONTEXT.md §7.4.3.
  avatarUrl String?

  sport Sport @relation(fields: [sportId], references: [id])
  team  Team? @relation(fields: [teamId], references: [id])

  @@index([sportId])
  @@index([teamId])
}

model Fixture {
  id            String   @id @default(cuid())
  sportId       String
  competitionId String
  seasonId      String
  slug          String
  name          String
  status        String // "scheduled" | "live" | "completed" | "postponed" | "cancelled"
  startTime     DateTime
  venueId       String?

  sport       Sport               @relation(fields: [sportId], references: [id])
  competition Competition         @relation(fields: [competitionId], references: [id])
  season      Season              @relation(fields: [seasonId], references: [id])
  venue       Venue?              @relation(fields: [venueId], references: [id])
  sessions    Session[]
  dataProfile FixtureDataProfile?

  @@unique([sportId, slug])
  @@index([competitionId, status])
  @@index([startTime])
}

/// Provider provenance and honest data-depth metadata for one imported
/// fixture. Kept separate from the core Fixture contract: live/current
/// ingestion predates the historical archive, and source/coverage are
/// ingestion concerns rather than universal sports-domain fields.
model FixtureDataProfile {
  id             String   @id @default(cuid())
  fixtureId      String   @unique
  source         String
  externalId     String
  coverage       String // "summary" | "partial" | "event-data"
  attribution    String?
  sourceRevision String?
  datePrecision  String? // "instant" | "day"
  importedAt     DateTime @default(now())

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([source, coverage])
}

/// Resume/audit record for an explicit, bounded historical import. This is
/// operational metadata only; the archive API reads normalized Fixture data,
/// never raw import payloads.
model HistoricalImport {
  id             String    @id @default(cuid())
  sportSlug      String
  source         String
  scopeKey       String
  status         String // "running" | "completed" | "failed"
  sourceRevision String?
  checksum       String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  importedCount  Int       @default(0)
  skippedCount   Int       @default(0)
  failedCount    Int       @default(0)
  error          String?
  metadata       Json      @default("{}")

  @@unique([source, scopeKey])
  @@index([sportSlug, startedAt])
  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  fixtureId String
  type      String
  status    String // "scheduled" | "live" | "completed" | "cancelled"
  startTime DateTime
  endTime   DateTime?

  fixture     Fixture             @relation(fields: [fixtureId], references: [id])
  liveEvents  LiveEvent[]
  dataProfile SessionDataProfile?

  @@index([fixtureId])
  @@index([status])
}

/// Import state belongs to a session, because providers can expose one part
/// of a race weekend while having no historical detail for another.
model SessionDataProfile {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  source        String
  status        String // "summary" | "importing" | "available" | "upstream-unavailable" | "failed"
  reason        String?
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  importedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([source, status])
  @@index([status, nextRetryAt])
}

/// Append-only. Never mutated after insert — corrections arrive as new rows.
model LiveEvent {
  id        String   @id @default(cuid())
  /// Database-assigned global order. Provider timestamps can collide or
  /// arrive late; this is the durable SSE resume cursor.
  sequence  BigInt   @unique @default(autoincrement())
  sportId   String
  sessionId String
  eventType String
  timestamp DateTime
  source    String
  payload   Json

  sport   Sport   @relation(fields: [sportId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, timestamp])
  @@index([sessionId, sequence])
  @@index([eventType])
}

model Standing {
  id            String @id @default(cuid())
  competitionId String
  seasonId      String
  entityType    String // "team" | "player"
  entityId      String
  points        Float
  position      Int
  extra         Json

  competition Competition @relation(fields: [competitionId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, entityType, entityId])
  @@index([competitionId, seasonId])
}

/// Raw provider payloads, retained for debugging/audit only — never the
/// primary application model (ARCHITECTURE.md §4, master brief §19).
model ProviderRawResponse {
  id          String   @id @default(cuid())
  providerId  String
  method      String
  requestedAt DateTime
  body        Json

  @@index([providerId, requestedAt])
}

/// Durable upstream resume position. A worker restart must not turn every
/// provider poll into an unbounded historical refetch.
model ProviderCursor {
  id         String   @id @default(cuid())
  providerId String
  sessionId  String
  cursor     String
  updatedAt  DateTime @updatedAt

  @@unique([providerId, sessionId])
  @@index([providerId, updatedAt])
}

// Education content deliberately has no table here. EducationConcept lives
// as version-controlled Markdown/MDX under /content/education and is read
// straight off disk by @sports/education (see ARCHITECTURE.md §6) — no
// database sync step, no CMS, until the relationship set actually outgrows
// what a developer can maintain by hand in files.

// ---------------------------------------------------------------------------
// F1 extension (Phase 1) — see ARCHITECTURE.md §5
// ---------------------------------------------------------------------------

model DriverTiming {
  id              String  @id @default(cuid())
  sessionId       String
  driverId        String
  position        Int
  /// Numeric seconds, or literally "+N LAP(S)" if lapped — mixed type at the OpenF1 source.
  gapToLeader     String?
  /// Gap to the car immediately ahead — same mixed-type reasoning as gapToLeader. See docs/CONTEXT.md §7.4.6.
  intervalToAhead String?
  /// Raw seconds (not formatted strings — corrected from the Phase 0 guess, see docs/CONTEXT.md §7.4.5).
  lastLapTime     Float?
  bestLapTime     Float?
  sector1         Float?
  sector2         Float?
  sector3         Float?
  tyreCompound    String?
  state           String // "running" | "out" | "dnf" | "dsq" | "dns"

  @@unique([sessionId, driverId])
  @@index([sessionId, position])
}

model PitStop {
  id         String   @id @default(cuid())
  sessionId  String
  driverId   String
  lap        Int
  durationMs Int
  timestamp  DateTime

  @@index([sessionId, driverId])
}

model RaceControlMessage {
  id        String   @id @default(cuid())
  sessionId String
  timestamp DateTime
  category  String // "flag" | "safety_car" | "vsc" | "red_flag" | "message"
  message   String

  @@index([sessionId, timestamp])
}

/// Final driver classification for one completed session. `durationSeconds`
/// follows OpenF1's session semantics: best time for practice, total elapsed
/// time for a race. Qualifying phase values are stored separately so null Q2/
/// Q3 eliminations remain truthful rather than collapsing an array.
model SessionClassification {
  id              String  @id
  sessionId       String
  driverId        String
  position        Int?
  status          String // "classified" | "dnf" | "dns" | "dsq"
  lapsCompleted   Int
  points          Float?
  durationSeconds Float?
  gapToLeader     String?
  phase1Duration  Float?
  phase2Duration  Float?
  phase3Duration  Float?
  phase1Gap       String?
  phase2Gap       String?
  phase3Gap       String?

  @@unique([sessionId, driverId])
  @@index([sessionId, position])
}

/// One normalized OpenF1 lap. Null timing fields represent a real upstream
/// omission (commonly pit-out/in-progress laps), never a fabricated zero.
model Lap {
  id          String    @id
  sessionId   String
  driverId    String
  lapNumber   Int
  startedAt   DateTime?
  duration    Float?
  sector1     Float?
  sector2     Float?
  sector3     Float?
  speedI1     Int?
  speedI2     Int?
  speedTrap   Int?
  isPitOutLap Boolean   @default(false)

  @@unique([sessionId, driverId, lapNumber])
  @@index([sessionId, driverId, lapNumber])
  @@index([sessionId, duration])
}

/// A driver's tyre run within a session. `lapEnd` remains nullable when the
/// provider has not supplied an end boundary.
model TyreStint {
  id             String  @id
  sessionId      String
  driverId       String
  stintNumber    Int
  lapStart       Int
  lapEnd         Int?
  compound       String?
  tyreAgeAtStart Int?

  @@unique([sessionId, driverId, stintNumber])
  @@index([sessionId, driverId, stintNumber])
}
