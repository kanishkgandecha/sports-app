// Core schema — see ARCHITECTURE.md §5 for the terminology and reasoning.
// Sport-specific extension tables (F1 first) are added as their own models
// below, one phase at a time — never retrofitted into the core tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core (shared across every sport)
// ---------------------------------------------------------------------------

model Sport {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  status String // "live" | "beta" | "education-only"

  competitions Competition[]
  teams        Team[]
  players      Player[]
  fixtures     Fixture[]
  liveEvents   LiveEvent[]

  @@index([slug])
}

model Competition {
  id      String @id @default(cuid())
  sportId String
  slug    String
  name    String
  type    String // "championship" | "league" | "tournament" | "cup"

  sport     Sport      @relation(fields: [sportId], references: [id])
  seasons   Season[]
  fixtures  Fixture[]
  standings Standing[]

  @@unique([sportId, slug])
  @@index([sportId])
}

model Season {
  id            String   @id @default(cuid())
  competitionId String
  label         String
  startDate     DateTime
  endDate       DateTime

  competition Competition @relation(fields: [competitionId], references: [id])
  fixtures    Fixture[]
  standings   Standing[]

  @@unique([competitionId, label])
  @@index([competitionId])
}

model Venue {
  id      String  @id @default(cuid())
  name    String
  /// Nullable since Cricket Checkpoint 1 — see @sports/domain's Venue doc
  /// comment. CricketData.org gives no separate country field; F1 rows
  /// are unaffected (OpenF1Adapter always populates a real value).
  country String?
  timezone String

  fixtures Fixture[]
}

model Team {
  id       String  @id @default(cuid())
  sportId  String
  name     String
  slug     String
  country  String?
  /// Brand/kit color e.g. "#3671C6". Cross-sport, not F1-specific — see docs/CONTEXT.md §7.4.2.
  colorHex String?

  sport   Sport    @relation(fields: [sportId], references: [id])
  players Player[]

  @@unique([sportId, slug])
  @@index([sportId])
}

model Player {
  id        String  @id @default(cuid())
  sportId   String
  teamId    String?
  name      String
  role      String?
  /// Abbreviated display code, e.g. F1's "VER". Cross-sport — see docs/CONTEXT.md §7.4.3.
  shortName String?
  /// Athlete photo/headshot. Cross-sport — see docs/CONTEXT.md §7.4.3.
  avatarUrl String?

  sport Sport @relation(fields: [sportId], references: [id])
  team  Team? @relation(fields: [teamId], references: [id])

  @@index([sportId])
  @@index([teamId])
}

model Fixture {
  id            String    @id @default(cuid())
  sportId       String
  competitionId String
  seasonId      String
  slug          String
  name          String
  status        String // "scheduled" | "live" | "completed" | "postponed" | "cancelled"
  startTime     DateTime
  venueId       String?

  sport       Sport       @relation(fields: [sportId], references: [id])
  competition Competition @relation(fields: [competitionId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])
  venue       Venue?      @relation(fields: [venueId], references: [id])
  sessions    Session[]

  @@unique([sportId, slug])
  @@index([competitionId, status])
  @@index([startTime])
}

model Session {
  id        String    @id @default(cuid())
  fixtureId String
  type      String
  status    String // "scheduled" | "live" | "completed" | "cancelled"
  startTime DateTime
  endTime   DateTime?

  fixture    Fixture     @relation(fields: [fixtureId], references: [id])
  liveEvents LiveEvent[]

  @@index([fixtureId])
  @@index([status])
}

/// Append-only. Never mutated after insert — corrections arrive as new rows.
model LiveEvent {
  id        String   @id @default(cuid())
  sportId   String
  sessionId String
  eventType String
  timestamp DateTime
  source    String
  payload   Json

  sport   Sport   @relation(fields: [sportId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, timestamp])
  @@index([eventType])
}

model Standing {
  id            String @id @default(cuid())
  competitionId String
  seasonId      String
  entityType    String // "team" | "player"
  entityId      String
  points        Float
  position      Int
  extra         Json

  competition Competition @relation(fields: [competitionId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, entityType, entityId])
  @@index([competitionId, seasonId])
}

/// Raw provider payloads, retained for debugging/audit only — never the
/// primary application model (ARCHITECTURE.md §4, master brief §19).
model ProviderRawResponse {
  id         String   @id @default(cuid())
  providerId String
  method     String
  requestedAt DateTime
  body       Json

  @@index([providerId, requestedAt])
}

// Education content deliberately has no table here. EducationConcept lives
// as version-controlled Markdown/MDX under /content/education and is read
// straight off disk by @sports/education (see ARCHITECTURE.md §6) — no
// database sync step, no CMS, until the relationship set actually outgrows
// what a developer can maintain by hand in files.

// ---------------------------------------------------------------------------
// F1 extension (Phase 1) — see ARCHITECTURE.md §5
// ---------------------------------------------------------------------------

model DriverTiming {
  id              String  @id @default(cuid())
  sessionId       String
  driverId        String
  position        Int
  /// Numeric seconds, or literally "+N LAP(S)" if lapped — mixed type at the OpenF1 source.
  gapToLeader     String?
  /// Gap to the car immediately ahead — same mixed-type reasoning as gapToLeader. See docs/CONTEXT.md §7.4.6.
  intervalToAhead String?
  /// Raw seconds (not formatted strings — corrected from the Phase 0 guess, see docs/CONTEXT.md §7.4.5).
  lastLapTime     Float?
  bestLapTime     Float?
  sector1         Float?
  sector2         Float?
  sector3         Float?
  tyreCompound    String?
  state           String // "running" | "out" | "dnf" | "dsq" | "dns"

  @@unique([sessionId, driverId])
  @@index([sessionId, position])
}

model PitStop {
  id          String   @id @default(cuid())
  sessionId   String
  driverId    String
  lap         Int
  durationMs  Int
  timestamp   DateTime

  @@index([sessionId, driverId])
}

model RaceControlMessage {
  id        String   @id @default(cuid())
  sessionId String
  timestamp DateTime
  category  String // "flag" | "safety_car" | "vsc" | "red_flag" | "message"
  message   String

  @@index([sessionId, timestamp])
}

// ---------------------------------------------------------------------------
// Cricket extension (Phase 2, Checkpoint 1) — see ARCHITECTURE.md §5 and
// docs/CONTEXT.md's Cricket domain proposal (Checkpoint 7 §8) and this
// checkpoint's implementation notes. Same no-FK-constraint pattern as the F1
// extension above (DriverTiming/PitStop/RaceControlMessage): plain indexed
// id columns, not `@relation` fields — a Phase 0/Checkpoint 2 schema
// characteristic kept consistent here rather than introduced ad hoc.
// ---------------------------------------------------------------------------

/// One row per Fixture (= match). Cricket-only facts a Fixture has no slot
/// for — see the doc comment on @sports/domain's CricketFixtureDetail for
/// why exactly these fields and no more.
model CricketFixtureDetail {
  id              String  @id @default(cuid())
  fixtureId       String  @unique
  /// Nullable — verified real: CricketData.org's own `matchType` is
  /// genuinely absent on some real matches. See @sports/domain's
  /// CricketFixtureDetail doc comment for the fallback heuristic.
  format          String? // "TEST" | "ODI" | "T20" | null
  tossWonByTeamId String?
  tossDecision    String? // "BAT" | "BOWL"
  result          String?

  @@index([fixtureId])
}

/// One row per Session (= innings) — current-state snapshot, the cricket
/// equivalent of DriverTiming. Upserted in place; never replayed from
/// LiveEvent to answer "what's the score right now."
model CricketInningsState {
  id               String  @id @default(cuid())
  sessionId        String  @unique
  battingTeamId    String
  bowlingTeamId    String
  runs             Int
  wickets          Int
  /// Decimal overs, e.g. 14.3 — matches the provider's own `o` field format.
  overs            Float
  strikerId        String?
  nonStrikerId     String?
  currentBowlerId  String?
  /// Derived (first innings total + 1), not read from the provider — see
  /// @sports/domain's CricketInningsState doc comment.
  target           Int?
  requiredRunRate  Float?

  @@index([sessionId])
}

/// Cricket Checkpoint 2 — one row per batsman per innings. See
/// @sports/domain's CricketBattingFigure doc comment for why this exists
/// and why it's scoped exactly this way (no extras/totals — verified
/// empty on every real scorecard captured).
model CricketBattingFigure {
  id            String @id @default(cuid())
  sessionId     String
  playerId      String
  battingOrder  Int
  runs          Int
  balls         Int
  fours         Int
  sixes         Int
  strikeRate    Float
  dismissalText String

  @@unique([sessionId, playerId])
  @@index([sessionId, battingOrder])
}

/// One row per bowler per innings (aggregated across all their overs —
/// matches the real provider shape, one entry per bowler, not per over).
model CricketBowlingFigure {
  id            String @id @default(cuid())
  sessionId     String
  playerId      String
  bowlingOrder  Int
  overs         Float
  maidens       Int
  runsConceded  Int
  wickets       Int
  economy       Float

  @@unique([sessionId, playerId])
  @@index([sessionId, bowlingOrder])
}
