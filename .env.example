# Copy to .env and adjust as needed.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://sports:sports@localhost:5432/sports_platform_dev"

# apps/api
API_PORT=4000

# apps/ingestion
# Interval, in ms, at which the synthetic provider emits fake LiveEvents
# during Phase 0 validation (see ARCHITECTURE.md §7, step 6).
INGESTION_SYNTHETIC_INTERVAL_MS=2000
