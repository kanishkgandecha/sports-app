# Copy to .env and adjust as needed.
#
# Read by apps/api and apps/ingestion directly (`--env-file=../../.env` in
# their `dev`/`start` scripts). apps/web does NOT read this file — Next.js
# only loads env files from its own app directory; see apps/web/.env.example
# if you need to override its defaults for local (non-Docker) dev.
#
# docker-compose.yml sets its own container-network values for most of
# these (DATABASE_URL, API_INTERNAL_URL, NEXT_PUBLIC_API_URL) directly in
# the compose file rather than reading this one — see its comments. This
# file documents what a plain `pnpm dev` (outside Docker) needs.

# ---- Postgres (matches docker-compose.yml's `postgres` service) -----------
DATABASE_URL="postgresql://sports:sports@localhost:5432/sports_platform_dev"

# ---- apps/api ---------------------------------------------------------------
API_PORT=4000

# ---- apps/ingestion — Phase 0 synthetic pipeline check ---------------------
# Interval, in ms, at which the synthetic provider emits fake LiveEvents
# during Phase 0 validation (see ARCHITECTURE.md §7, step 6).
INGESTION_SYNTHETIC_INTERVAL_MS=2000

# ---- apps/ingestion — F1 live-data job (OpenF1) ----------------------------
# "openf1" (default) runs the real F1 job; "disabled" turns it off entirely.
F1_PROVIDER=openf1
# How often the F1 job polls each currently-active session, in ms.
F1_POLL_INTERVAL_MS=15000
# Safety cap, in ms, for a session with no known/sane end time.
F1_MAX_SESSION_DURATION_MS=14400000
# Minimum delay, in ms, between successive requests while bootstrapping a
# season's fixtures (stays under OpenF1's free-tier rate limit).
F1_BOOTSTRAP_REQUEST_DELAY_MS=400
# Comma-separated season year(s) the calendar bootstrap covers. Defaults to
# the current year only; set explicitly (e.g. "2023,2024,2025,2026") to
# backfill more history.
F1_BOOTSTRAP_SEASONS=2026

# ---- apps/ingestion — F1 standings sync (Jolpica-F1) -----------------------
# See docs/CONTEXT.md, Checkpoint 6 §4 — standings are a separate concern
# from F1_PROVIDER above; OpenF1 is never replaced. "jolpica" (default) runs
# the real standings sync; "disabled" turns it off.
F1_STANDINGS_PROVIDER=jolpica
# How often the standings sync re-fetches, in ms. Standings change at most
# once per race weekend — nowhere near F1_POLL_INTERVAL_MS's cadence.
F1_STANDINGS_POLL_INTERVAL_MS=1800000
# Comma-separated season year(s) the standings sync covers. Defaults to
# F1_BOOTSTRAP_SEASONS, then the current year — override independently only
# if you want standings synced for a different season than the calendar
# bootstrap covers.
# F1_STANDINGS_SEASONS=2026

# ---- apps/web — see apps/web/.env.example for the Next.js-local file ------
# NEXT_PUBLIC_API_URL: browser-reachable API origin, baked in at build time
#   (Docker: passed as a build ARG in docker-compose.yml, not read from
#   here — see apps/web/Dockerfile).
# API_INTERNAL_URL: server-side (Docker container-to-container) API origin,
#   a genuine runtime env var. Unset outside Docker — both fall back to
#   http://localhost:4000, which is correct for plain `pnpm dev`.
