{
  "name": "sports-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sports/db exec prisma generate",
    "db:migrate": "pnpm --filter @sports/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @sports/db exec tsx prisma/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
